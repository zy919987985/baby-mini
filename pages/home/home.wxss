.offline-banner {
  background: #FFF3DC;
  color: #A9761A;
  font-size: 22rpx;
  line-height: 1.6;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.home-head {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx 28rpx;
}

.hello {
  font-size: 36rpx;
  font-weight: 700;
  color: #3B322E;
}

.home-sub {
  font-size: 24rpx;
  color: #A0978F;
  margin-top: 10rpx;
}

.head-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFE4D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(255, 122, 89, 0.16);
}

.tip-card {
  display: flex;
  align-items: center;
  background: linear-gradient(120deg, #FFE9DC, #FFF3E5);
  border-radius: 26rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.tip-emoji {
  font-size: 56rpx;
  margin-right: 22rpx;
}

.tip-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #B4603F;
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #966E58;
  line-height: 1.55;
}

.quick-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 26rpx 0;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(180, 140, 115, 0.07);
}

.quick {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  border-right: 2rpx solid #F5EFEA;
}

.quick:last-child { border-right: none; }
.quick-emoji { font-size: 46rpx; margin-bottom: 10rpx; }
.quick-label { font-size: 24rpx; color: #6E615A; }

.quick-badge {
  position: absolute;
  top: -8rpx;
  right: 26rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #F2637B;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 0 6rpx;
}

.segment {
  display: flex;
  align-items: center;
  margin: 8rpx 4rpx 24rpx;
}

.seg-item {
  font-size: 27rpx;
  color: #A0978F;
  margin-right: 40rpx;
  padding-bottom: 12rpx;
  position: relative;
}

.seg-on {
  color: #FF7A59;
  font-weight: 700;
  font-size: 30rpx;
}

.seg-on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 6rpx;
  border-radius: 6rpx;
  background: #FF7A59;
}

/* ---------- 虚拟列表：定高条目 ----------
 * 单条总高 748rpx = 722rpx 卡片 + 26rpx 间距，
 * 与 utils/virtual-list.js 的 ITEM_RPX 必须一致。
 * 卡片内部可用高度 = 722 - 28*2(padding) = 666rpx，按分区固定：
 *   88(head) + 58(title) + 149(content) + 258(media)
 *   + 42(tags) + 71(actions) = 666rpx
 * 每个分区都不允许被内容撑高，否则上下占位会算错、列表会抖动。
 */
.post-list { width: 100%; }

.v-slot {
  box-sizing: border-box;
  padding-bottom: 26rpx;
}

.v-pad { width: 100%; }

.v-item {
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.post { margin-bottom: 0; }

.post-head {
  display: flex;
  align-items: center;
  height: 68rpx;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #FFF0E7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 18rpx;
}

.post-author { font-size: 27rpx; font-weight: 600; color: #4A3E37; }
.post-time { font-size: 22rpx; color: #ADA39B; margin-top: 6rpx; }

.post-title {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 46rpx;
  height: 46rpx;
  margin-bottom: 12rpx;
  flex-shrink: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.post-content {
  font-size: 26rpx;
  color: #7C706A;
  line-height: 43rpx;
  height: 129rpx;
  margin-bottom: 20rpx;
  flex-shrink: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-media {
  height: 240rpx;
  margin-bottom: 18rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.post-cover { height: 240rpx; }

.cover-label {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #8A5B44;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  height: 240rpx;
  overflow: hidden;
}

.post-img {
  width: 216rpx;
  height: 216rpx;
  border-radius: 16rpx;
  margin: 0 12rpx 12rpx 0;
  background: #FAF6F3;
}

.post-tags {
  height: 34rpx;
  margin-bottom: 8rpx;
  flex-shrink: 0;
  overflow: hidden;
  white-space: nowrap;
}

.post-actions {
  display: flex;
  border-top: 2rpx solid #F5EFEA;
  padding-top: 20rpx;
  height: 71rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.act {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: #8C8079;
}

.act-icon { font-size: 28rpx; }
.act-on { color: #FF7A59; font-weight: 600; }

/* 底部加载状态：加载中 / 已加载，两种文案都不含条数 */
.list-status {
  text-align: center;
  font-size: 22rpx;
  color: #B7ABA3;
  padding: 10rpx 0 40rpx;
}

.status-loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFB199;
  margin-right: 12rpx;
  animation: status-pulse 1s ease-in-out infinite;
}

@keyframes status-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* ------------------------------------------------------------------
 * 以上 .post-* / .v-* / .segment 等为「社区帖子虚拟列表」样式。
 * 社交类目暂缓，对应 WXML 已整段注释；样式原样保留，恢复时无需重写。
 * 以下为「官方号每日推荐辅食」新增样式。
 * ------------------------------------------------------------------ */

.daily-head {
