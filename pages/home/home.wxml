<view class="page-wrap">

  <!-- 社交类目暂缓：首页已无云端帖子流，离线横幅一并停用 -->
  <!-- <view wx:if="{{cloudOffline}}" class="offline-banner">⚠️ 云端未连接，当前展示本地缓存；离线期间的改动暂未同步</view> -->

  <view class="home-head">
    <view class="flex1">
      <view class="hello">{{greeting}}，{{babyName}}的家长 👋</view>
      <view class="home-sub">{{babyName}} · {{ageText}} · {{stageName}}</view>
    </view>
    <view class="head-avatar" bindtap="goProfile">{{babyAvatar}}</view>
  </view>

  <view class="tip-card">
    <view class="tip-emoji">🍼</view>
    <view class="flex1">
      <view class="tip-title">今日辅食建议</view>
      <view class="tip-text">{{todayTip}}</view>
    </view>
  </view>

  <view class="quick-row">
    <view class="quick" bindtap="goCook">
      <text class="quick-emoji">👩‍🍳</text>
      <text class="quick-label">生成辅食</text>
    </view>
    <view class="quick" bindtap="goIngredients">
      <text class="quick-emoji">🥕</text>
      <text class="quick-label">食材标记</text>
    </view>
    <!-- 社交类目暂缓：原「消息 / 未读角标」入口改为「宝宝档案」 -->
    <view class="quick" bindtap="goProfile">
      <text class="quick-emoji">👶</text>
      <text class="quick-label">宝宝档案</text>
    </view>
  </view>

  <!-- 社交类目暂缓：帖子筛选（最新 / 我的收藏）已停用，见文件末尾注释块 -->

  <!-- ============ 官方号每日推荐辅食 ============ -->
  <view class="daily-head">
    <view class="flex1">
      <view class="daily-head-title">🍽️ 今日推荐辅食</view>
      <view class="daily-head-sub">{{account.name}} · {{dailyDateText}} 02:00 发布 · {{updateText}}</view>
    </view>
    <view class="official-badge">官方</view>
  </view>

  <view class="daily-note">由官方号每日凌晨 02:00 更新 6 条，内容为编辑整理的辅食参考，不含用户发布内容。特殊情况请咨询儿科医生。</view>

  <view wx:for="{{dailyItems}}" wx:key="id" class="card daily-card">
    <view class="daily-card-head">
      <view class="daily-emoji">{{item.emoji}}</view>
      <view class="flex1">
        <view class="daily-author"><text class="official-tag">官方</text>{{item.authorName}}</view>
        <view class="daily-time">{{item.timeText}}</view>
      </view>
      <view class="daily-no">NO.{{item.no}}</view>
    </view>

    <view class="daily-title-row">{{item.title}}</view>
    <view class="daily-desc">{{item.desc}}</view>

    <view class="daily-tags">
      <text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="tag tag-green">{{tg}}</text>
    </view>

    <view class="daily-meta">
      <text class="meta-chip">👶 {{item.ageTag}}</text>
      <text class="meta-chip">🍽️ {{item.meal}}</text>
    </view>
    <view class="daily-nutrition">营养重点：{{item.nutrition}}</view>

    <view wx:if="{{item.open}}" class="daily-detail">
      <view class="detail-title">🥣 食材用量</view>
      <view wx:for="{{item.ingredients}}" wx:for-item="ing" wx:key="name" class="detail-line">• {{ing.name}} {{ing.amount}}</view>
      <view class="detail-title">📝 制作步骤</view>
      <view wx:for="{{item.steps}}" wx:for-item="st" wx:key="no" class="detail-step">
        <text class="step-n">{{st.no}}</text>
        <view class="flex1">{{st.t}}：{{st.d}}</view>
      </view>
      <view class="detail-title">💡 喂养小贴士</view>
      <view wx:for="{{item.tips}}" wx:for-item="tip" wx:key="*this" class="detail-line">· {{tip}}</view>
    </view>

    <view class="daily-more" data-index="{{index}}" bindtap="toggleDaily">{{item.open ? '收起做法 ▲' : '查看做法 ▼'}}</view>
  </view>

  <view class="daily-foot">下一期 {{nextDateText}} 02:00 更新 · {{account.name}}</view>
  <!-- ========== 官方号每日推荐辅食 END ========== -->

  <!--
    社交类目暂缓（个人小程序未开放社交类目）：以下为原社区帖子功能，
    代码原样保留但不渲染。恢复方式见 pages/home/home.js 顶部说明，
    原始完整版本在 .workbuddy/backup/social-disabled-20261110/home/。

    注意：XML 注释内不能出现连续两个半角连字符，原内层注释已改写成普通文字。

    首页原有「最新 / 我的收藏」筛选（都按发布时间倒序）：
    <view class="segment">
      <view class="seg-item {{filter === '最新' ? 'seg-on' : ''}}" data-f="最新" bindtap="onFilter">最新</view>
      <view class="seg-item {{filter === '收藏' ? 'seg-on' : ''}}" data-f="收藏" bindtap="onFilter">我的收藏</view>
    </view>

    虚拟列表容器：上下占位撑起总高度，中间只渲染可视窗口内的卡片。
    padTop / padBottom 单位为 px，slot 高度单位为 rpx。
    <view id="post-list" class="post-list">
      <view class="v-pad" style="height: {{padTop}}px"></view>
      <view wx:for="{{visiblePosts}}" wx:key="id" class="v-slot" style="height: {{slotRpx}}rpx">
        <view class="post card v-item">
          <view class="post-head" data-id="{{item.id}}" bindtap="openPost">
            <view class="avatar">{{item.authorAvatar}}</view>
            <view class="flex1">
              <view class="post-author">{{item.authorName}}</view>
              <view class="post-time">{{item.timeText}} · {{item.ageTag}}</view>
            </view>
            <view wx:if="{{item.isMine}}" class="tag tag-gray">我的</view>
          </view>
          <view data-id="{{item.id}}" bindtap="openPost">
            <view class="post-title">{{item.title}}</view>
            <view class="post-content">{{item.content}}</view>
            <view class="post-media">
              <view wx:if="{{!item.images || !item.images.length}}" class="post-cover cover" style="background: {{item.coverStyle}}">
                <text class="cover-emoji">{{item.coverEmoji}}</text>
                <view wx:if="{{item.recipeTitle}}" class="cover-label">📖 {{item.recipeTitle}}</view>
              </view>
              <view wx:if="{{item.images && item.images.length}}" class="post-images">
                <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="post-img" src="{{img}}" mode="aspectFill" data-urls="{{item.images}}" data-current="{{img}}" catchtap="previewPostImage" />
              </view>
            </view>
            <view class="post-tags">
              <text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="tag tag-green">{{tg}}</text>
            </view>
          </view>
          <view class="post-actions">
            <view class="act {{item.liked ? 'act-on' : ''}}" data-id="{{item.id}}" bindtap="onLike">
              <text class="act-icon">{{item.liked ? '❤️' : '🤍'}}</text> {{item.likeCount}}
            </view>
            <view class="act" data-id="{{item.id}}" bindtap="openPost">
              <text class="act-icon">💬</text> {{item.commentCount}}
            </view>
            <view class="act {{item.favorited ? 'act-on' : ''}}" data-id="{{item.id}}" bindtap="onFav">
              <text class="act-icon">{{item.favorited ? '⭐' : '☆'}}</text> {{item.favCount}}
            </view>
          </view>
        </view>
      </view>
      <view class="v-pad" style="height: {{padBottom}}px"></view>
    </view>

    <view wx:if="{{loadedCount === 0}}" class="empty">
      <text class="empty-emoji">🍽️</text>
      <view class="empty-text">{{filter === '收藏' ? '还没有收藏的帖子，去逛逛吧' : '还没有帖子，来发第一条吧'}}</view>
    </view>

    底部加载状态：只显示「加载中 / 已加载」，不展示具体条数。
    <view wx:if="{{loadedCount > 0}}" class="list-status">
      <view wx:if="{{hasMore}}" class="status-loading"><view class="loading-dot"></view>加载中...</view>
      <text wx:else>已全部加载</text>
    </view>

    <view class="fab" bindtap="goPublish">+</view>
  -->

  <auth-modal />
</view>
