.form-label { font-size: 27rpx; font-weight: 700; color: #433832; margin-bottom: 16rpx; }
.form-hint { font-size: 21rpx; color: #A9A099; font-weight: 400; }
.mt { margin-top: 34rpx; }

.title-input {
  background: #FAF6F3;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.title-input.small { font-size: 26rpx; font-weight: 400; }

.content-input {
  background: #FAF6F3;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.7;
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
}

.counter { text-align: right; font-size: 21rpx; color: #B7ABA3; margin-top: 8rpx; }

/* ---------------- 图片选择与逐张审核状态 ---------------- */

.img-grid { display: flex; flex-wrap: wrap; }

.img-cell {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: #FAF6F3;
}

.up-img { width: 100%; height: 100%; display: block; }

.img-mask, .img-ok, .img-pending {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 20rpx;
  padding: 6rpx 0;
  line-height: 1.4;
}

.img-mask { background: rgba(224, 82, 110, 0.92); color: #FFFFFF; font-weight: 600; }
.img-ok { background: rgba(60, 168, 132, 0.9); color: #FFFFFF; }
.img-pending { background: rgba(90, 78, 70, 0.62); color: #FFFFFF; }

.img-del {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(45, 33, 28, 0.6);
  color: #FFFFFF;
  font-size: 30rpx;
}

.img-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #E4D3C8;
  background: #FFFBF8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.add-plus { font-size: 46rpx; color: #FF9A73; line-height: 1; }
.add-text { font-size: 21rpx; color: #A9A099; margin-top: 10rpx; }
.img-hint { font-size: 21rpx; color: #A9A099; line-height: 1.6; }

/* ---------------- 审核状态 ---------------- */

.audit-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-top: 26rpx;
  box-shadow: 0 8rpx 30rpx rgba(180, 140, 115, 0.07);
}

.audit-spinner {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  margin-right: 22rpx;
  border: 5rpx solid #FFE1D3;
  border-top-color: #FF7A59;
  border-radius: 50%;
  animation: audit-spin 0.9s linear infinite;
}

@keyframes audit-spin { to { transform: rotate(360deg); } }

.audit-title { font-size: 27rpx; font-weight: 700; color: #433832; }
.audit-sub { font-size: 23rpx; color: #A9A099; margin-top: 8rpx; line-height: 1.5; }

.audit-error {
  background: #FFEDEF;
  border: 2rpx solid #FFD2DA;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-top: 26rpx;
}

.audit-error-title { font-size: 27rpx; font-weight: 700; color: #C23B57; }
.audit-error-reason { font-size: 25rpx; color: #8E4253; line-height: 1.7; margin-top: 12rpx; }
.audit-error-tip { font-size: 21rpx; color: #B98B95; margin-top: 12rpx; }

.btn-busy { opacity: 0.65; }

/* ---------------- 封面与发布 ---------------- */

.cover-preview { height: 220rpx; margin-bottom: 20rpx; }

.emoji-grid { display: flex; flex-wrap: wrap; }

.emoji-item {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #FAF6F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin: 0 14rpx 14rpx 0;
  border: 2rpx solid transparent;
}

.emoji-on { border-color: #FF7A59; background: #FFEDE6; }

.publish-tip {
  font-size: 22rpx;
  color: #A98A76;
  background: #FFF1E7;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  line-height: 1.6;
  margin: 28rpx 0;
}

.tip-strong { font-weight: 700; color: #C46A45; }
.tip-warn { margin-top: 12rpx; color: #C23B57; }

.publish-btn { margin-bottom: 20rpx; }
