.stat-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 26rpx 0;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 30rpx rgba(180, 140, 115, 0.07);
}

.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 38rpx; font-weight: 700; color: #3B322E; }
.stat-label { font-size: 21rpx; color: #A0978F; margin-top: 6rpx; }
.stat-line { width: 2rpx; height: 44rpx; background: #F4EDE8; }

.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 18rpx 26rpx;
  margin-bottom: 18rpx;
}

.search-icon { font-size: 26rpx; margin-right: 14rpx; }
.search-input { flex: 1; font-size: 27rpx; }
.clear { color: #B8ACA4; font-size: 26rpx; padding: 0 8rpx; }

.hint {
  font-size: 22rpx;
  color: #A98A76;
  background: #FFF1E7;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  line-height: 1.55;
  margin-bottom: 22rpx;
}

.filter-scroll { white-space: nowrap; margin-bottom: 6rpx; }
.filter-row { display: inline-flex; }

.reset-row { display: flex; justify-content: flex-end; margin-bottom: 14rpx; }
.reset-btn {
  font-size: 22rpx;
  color: #FF7A59;
  background: #FFF1EA;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}
.reset-btn::after { border: none; }

.group { margin-top: 30rpx; }

.group-head { display: flex; align-items: center; margin: 0 4rpx 14rpx; }

.group-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 14rpx;
}

.group-name { font-size: 29rpx; font-weight: 700; flex: 1; }
.group-count { font-size: 22rpx; color: #A9A099; }

.group-card { padding: 6rpx 24rpx; }

.ing-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F7F2EE;
}

.ing-row:last-child { border-bottom: none; }

.ing-emoji {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #FAF6F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 18rpx;
}

.ing-name { font-size: 27rpx; font-weight: 600; color: #433832; }
.ing-note { font-size: 21rpx; color: #A9A099; margin-top: 7rpx; }

.allergen {
  font-size: 19rpx;
  color: #C8891A;
  background: #FFF3DC;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  font-weight: 400;
}

.status-pill {
  font-size: 22rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
}

.add-btn {
  margin: 40rpx 0 20rpx;
  border: 2rpx dashed #FFC4AC;
  color: #FF7A59;
  font-size: 27rpx;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 22rpx;
  background: #FFF6F1;
}
