.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(125deg, #FFD9C0, #FFC0A4);
  border-radius: 28rpx;
  padding: 34rpx 28rpx;
  margin-bottom: 10rpx;
}

.user-avatar {
  width: 108rpx;
  height: 108rpx;
  flex: 0 0 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 22rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
}

.user-avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.user-name { font-size: 34rpx; font-weight: 700; color: #7C3F29; }
.user-desc { font-size: 21rpx; color: #9C6149; margin-top: 10rpx; line-height: 1.4; }

.login-btn {
  background: #FFFFFF;
  color: #FF7A59;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
}

.logout { font-size: 23rpx; color: #9C6149; padding: 12rpx; }

.baby-card { margin-bottom: 20rpx; }

.baby-top { display: flex; align-items: center; }

.baby-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #FFEDE6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 20rpx;
}

.baby-name { font-size: 32rpx; font-weight: 700; }
.baby-gender {
  font-size: 21rpx;
  color: #FF7A59;
  background: #FFEDE6;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 10rpx;
  font-weight: 400;
}

.baby-sub { font-size: 22rpx; color: #A0978F; margin-top: 10rpx; }

.edit-btn {
  font-size: 23rpx;
  color: #FF7A59;
  border: 2rpx solid #FFCDBA;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.baby-metrics {
  display: flex;
  background: #FAF6F3;
  border-radius: 20rpx;
  padding: 22rpx 0;
  margin-top: 26rpx;
}

.metric { flex: 1; text-align: center; border-right: 2rpx solid #F0E9E3; }
.metric:last-child { border-right: none; }
.metric-num { font-size: 30rpx; font-weight: 700; color: #433832; }
.metric-num.red { color: #E0526E; }
.unit { font-size: 19rpx; font-weight: 400; color: #A0978F; margin-left: 4rpx; }
.metric-label { font-size: 20rpx; color: #A0978F; margin-top: 8rpx; }

.baby-note {
  font-size: 23rpx;
  color: #8C7A6E;
  background: #FFF6EF;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin-top: 20rpx;
}

.add-baby {
  border: 2rpx dashed #FFC4AC;
  color: #FF7A59;
  font-size: 26rpx;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 22rpx;
  background: #FFF6F1;
}

.empty-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(255, 154, 122, 0.08);
}
.empty-card-emoji { font-size: 96rpx; }
.empty-card-title { font-size: 32rpx; font-weight: 700; color: #433832; margin-top: 20rpx; }
.empty-card-sub { font-size: 24rpx; color: #A0978F; margin-top: 14rpx; line-height: 1.6; padding: 0 20rpx; }
.empty-card-btn {
  display: inline-block;
  margin-top: 34rpx;
  background: linear-gradient(125deg, #FF8A6A, #FF7A59);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 89, 0.28);
}

.stat-card { display: flex; padding: 30rpx 0; }
.stat-cell { flex: 1; text-align: center; border-right: 2rpx solid #F4EDE8; }
.stat-cell:last-child { border-right: none; }
.stat-cell-num { font-size: 36rpx; font-weight: 700; color: #FF7A59; }
.stat-cell-label { font-size: 21rpx; color: #A0978F; margin-top: 10rpx; }

.menu-card { padding: 6rpx 26rpx; }
.menu-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #F7F2EE;
  font-size: 27rpx;
}
.menu-row:last-child { border-bottom: none; }
.menu-emoji { font-size: 32rpx; margin-right: 18rpx; }
.menu-value { font-size: 23rpx; color: #A9A099; }

.foot-note { text-align: center; font-size: 20rpx; color: #BDB2AA; margin: 40rpx 0 10rpx; line-height: 1.6; }

.login-tip { font-size: 23rpx; color: #A0978F; text-align: center; margin-bottom: 28rpx; }

.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #FAF6F3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  padding: 0;
  line-height: 1.2;
  overflow: hidden;
  border: 2rpx dashed #FFCDBA;
}

.avatar-picker::after { border: none; }
.picker-emoji { font-size: 56rpx; }
.picker-hint { font-size: 18rpx; color: #B0A49B; margin-top: 8rpx; }
.picked-avatar { width: 160rpx; height: 160rpx; border-radius: 50%; }

.modal-cancel { text-align: center; font-size: 26rpx; color: #A0978F; padding: 28rpx 0 0; }
.local-note {
  font-size: 20rpx;
  color: #B0A49B;
  text-align: center;
  line-height: 1.6;
  background: #FAF6F3;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-top: 24rpx;
}

.picker-value { font-size: 27rpx; color: #433832; }
.two-col { display: flex; }
.two-col .field { flex: 1; }
.two-col .field:first-child { margin-right: 18rpx; }

.delete-baby { text-align: center; color: #E0526E; font-size: 25rpx; margin-top: 24rpx; }

.recipe-scroll { max-height: 580rpx; }
.recipe-line { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #F7F2EE; }
.recipe-line-emoji { font-size: 42rpx; margin-right: 18rpx; }
.recipe-line-title { font-size: 27rpx; font-weight: 600; }
.recipe-line-sub { font-size: 21rpx; color: #A9A099; margin-top: 8rpx; }

.about-text { font-size: 25rpx; color: #6E615A; line-height: 1.8; margin-bottom: 22rpx; }
.code { color: #FF7A59; background: #FFEDE6; padding: 2rpx 8rpx; border-radius: 6rpx; font-size: 22rpx; }
