.hero {
  display: flex;
  align-items: center;
  background: linear-gradient(120deg, #FFD9C0, #FFB59A);
  border-radius: 28rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 24rpx;
}
.hero-emoji { font-size: 72rpx; margin-right: 20rpx; }
.hero-title { font-size: 32rpx; font-weight: 700; color: #7C3F29; }
.hero-sub { font-size: 22rpx; color: #9C6149; margin-top: 10rpx; line-height: 1.5; }

/* 能力不可用提示 */
.notice-card {
  background: #FFF3DC;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
}
.notice-title { font-size: 26rpx; font-weight: 700; color: #A9761A; margin-bottom: 12rpx; }
.notice-text { font-size: 22rpx; color: #A9761A; line-height: 1.7; }

.form-card { margin-bottom: 10rpx; }
.form-label { font-size: 27rpx; font-weight: 700; color: #433832; margin-bottom: 18rpx; }
.form-link { font-size: 23rpx; color: #FF7A59; }
.mt { margin-top: 28rpx; }

.prompt-input {
  background: #FAF6F3;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.7;
  width: 100%;
  min-height: 190rpx;
  box-sizing: border-box;
}
.prompt-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.counter { font-size: 21rpx; color: #B7ABA3; }

.sample-scroll { white-space: nowrap; width: 100%; }
.sample-chip {
  display: inline-block;
  white-space: nowrap;
  font-size: 23rpx;
  color: #A45B3F;
  background: #FFF1E9;
  border: 2rpx solid #FFDCCB;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin: 0 14rpx 8rpx 0;
}

.chip-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.chip-row.wrap { flex-wrap: wrap; }
.chip-row.wrap .chip { margin-bottom: 14rpx; }

.gen-btn { margin-top: 20rpx; }
.btn-busy { opacity: 0.7; }
.engine-tip { font-size: 21rpx; color: #B0A49B; text-align: center; margin-top: 18rpx; line-height: 1.5; }

/* ---------- 生成中 ---------- */
.loading-card { padding: 40rpx 32rpx 34rpx; }
.spinner-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.spinner-ring {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border: 8rpx solid #FFE7D6;
  border-top-color: #FF7A59;
  border-radius: 50%;
  animation: ig-spin 0.9s linear infinite;
}
.spinner-emoji { font-size: 54rpx; }
@keyframes ig-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.loading-title { font-size: 28rpx; font-weight: 700; color: #433832; text-align: center; }
.loading-cond { font-size: 22rpx; color: #A9A099; text-align: center; margin-top: 12rpx; line-height: 1.6; }
.loading-track { height: 8rpx; background: #F6EDE8; border-radius: 999rpx; overflow: hidden; margin: 28rpx 0 14rpx; }
.loading-progress {
  width: 40%; height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #FFB59A, #FF7A59);
  animation: ig-slide 1.6s ease-in-out infinite;
}
@keyframes ig-slide { from { transform: translateX(-100%); } to { transform: translateX(320%); } }
.loading-wait { font-size: 21rpx; color: #B0A49B; text-align: center; }

.skeleton { margin-top: 34rpx; }
.sk-line {
  height: 22rpx;
  border-radius: 8rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(90deg, #F6F1EE 25%, #FFEDE6 50%, #F6F1EE 75%);
  background-size: 200% 100%;
  animation: ig-shimmer 1.4s linear infinite;
}
.sk-line:last-child { margin-bottom: 0; }
.sk-title { height: 32rpx; width: 56%; }
.sk-mid { width: 84%; }
.sk-short { width: 62%; }
@keyframes ig-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

/* ---------- 结果卡片 ---------- */
.result-card { margin-bottom: 10rpx; }
.result-img {
  width: 100%;
  border-radius: 20rpx;
  display: block;
  background: #FAF6F3;
}
.result-expired {
  background: #FAF6F3;
  border-radius: 20rpx;
  padding: 90rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A9A099;
}
.result-prompt { font-size: 25rpx; color: #433832; line-height: 1.6; margin-top: 22rpx; }
.result-revised {
  font-size: 21rpx;
  color: #8A7C74;
  background: #FAF6F3;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}
.result-meta { font-size: 21rpx; color: #B0A49B; margin-top: 16rpx; }
.saved-badge {
  color: #3CA884;
  background: #E6F7F0;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  margin-left: 14rpx;
}

.result-actions { display: flex; margin-top: 26rpx; }
.result-actions .act { flex: 1; }
.act-busy { opacity: 0.6; }

.result-links { display: flex; justify-content: space-around; margin-top: 24rpx; }
.act-link { font-size: 24rpx; color: #FF7A59; }

.result-note {
  font-size: 20rpx;
  color: #B0A49B;
  line-height: 1.6;
  background: #FAF6F3;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin-top: 24rpx;
}

.foot-note { text-align: center; font-size: 20rpx; color: #BDB2AA; margin: 40rpx 0 10rpx; line-height: 1.6; }
