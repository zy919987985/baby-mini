<view class="page-wrap">

  <view class="hero">
    <view class="hero-emoji">🎨</view>
    <view class="flex1">
      <view class="hero-title">生图小助手</view>
      <view class="hero-sub">一句话描述画面，AI 帮你画出辅食灵感</view>
    </view>
  </view>

  <view wx:if="{{!available}}" class="notice-card">
    <view class="notice-title">⚠️ 生图能力暂不可用</view>
    <view class="notice-text">{{availabilityHint}}</view>
    <view class="notice-text">本功能消耗{{planName}}赠送的生图额度，可在 {{creditHint}} 查看剩余张数。</view>
    <view class="notice-text">页面仍可编辑描述，恢复后即可生成图片。</view>
  </view>

  <view class="card form-card">
    <view class="form-label">描述你想要的画面</view>
    <textarea class="prompt-input" placeholder="例如：一碗南瓜小米辅食泥，摆在浅木色餐桌上，柔和自然光…" value="{{prompt}}" bindinput="onPrompt" maxlength="{{maxPrompt}}" auto-height />
    <view class="prompt-foot">
      <text class="counter">{{promptLength}}/{{maxPrompt}}</text>
      <text class="form-link" bindtap="onClearPrompt">清空</text>
    </view>

    <view class="form-label mt">试试这些灵感</view>
    <scroll-view scroll-x class="sample-scroll">
      <view wx:for="{{samples}}" wx:key="label" class="sample-chip" data-i="{{index}}" bindtap="onSample">{{item.label}}</view>
    </scroll-view>

    <view class="form-label mt">画风</view>
    <view class="chip-row wrap">
      <view wx:for="{{styles}}" wx:key="label" class="chip {{styleIndex === index ? 'chip-active' : ''}}" data-i="{{index}}" bindtap="onStyle">{{item.label}}</view>
    </view>

    <view class="form-label mt">尺寸</view>
    <view class="chip-row wrap">
      <view wx:for="{{sizes}}" wx:key="value" class="chip {{sizeIndex === index ? 'chip-active' : ''}}" data-i="{{index}}" bindtap="onSize">{{item.label}}</view>
    </view>

    <view class="btn-primary gen-btn {{generating ? 'btn-busy' : ''}}" bindtap="onGenerate">{{generating ? '正在生成…' : '✨ 生成图片'}}</view>
    <view class="engine-tip">由{{planName}} · {{engineLabel}} 模型生成（消耗成长计划生图额度）· 描述会上传云端处理，请勿填写个人敏感信息</view>
  </view>

  <!-- 生成中 -->
  <block wx:if="{{generating}}">
    <view class="section-title">正在生成</view>
    <view class="card loading-card">
      <view class="spinner-wrap">
        <view class="spinner-ring"></view>
        <text class="spinner-emoji">🖌️</text>
      </view>
      <view class="loading-title">{{loadingText}}</view>
      <view class="loading-cond">描述将用于画面生成 · 结果链接有效期 24 小时</view>
      <view class="loading-track"><view class="loading-progress"></view></view>
      <view class="loading-wait">已等待 {{waitSeconds}} 秒 · 生图通常比文字生成更慢，请耐心等待</view>
      <view class="skeleton">
        <view class="sk-line sk-title"></view>
        <view class="sk-line"></view>
        <view class="sk-line sk-mid"></view>
        <view class="sk-line sk-short"></view>
      </view>
    </view>
  </block>

  <!-- 生成结果 -->
  <block wx:if="{{result && !generating}}">
    <view class="section-title">生成结果</view>
    <view class="card result-card">
      <image wx:if="{{result.src}}" class="result-img" src="{{result.src}}" mode="widthFix" bindtap="onPreviewResult" />
      <view wx:else class="result-expired">图片链接已失效，请重新生成</view>

      <view class="result-actions">
        <view class="btn-ghost act {{saving ? 'act-busy' : ''}}" bindtap="onSaveAlbum">⬇️ 保存到相册</view>
      </view>

      <view class="result-note">结果链接仅 24 小时有效；点击「保存到相册」会先把图片下载并转存到本机永久文件，再写入系统相册，避免链接过期后无法保存。图片右下角的 AI 生成标识由平台按法规添加。</view>
    </view>
  </block>

  <view class="foot-note">AI 生成图片仅供灵感参考，不代表真实辅食做法或喂养建议；请遵守平台内容规范，勿生成违规内容。</view>
</view>
