.hero {
  display: flex;
  align-items: center;
  background: linear-gradient(120deg, #FFD9C0, #FFB59A);
  border-radius: 28rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 24rpx;
}

.hero-emoji { font-size: 72rpx; margin-right: 20rpx; }
.hero-title { font-size: 32rpx; font-weight: 700; color: #7C3F29; }
.hero-sub { font-size: 22rpx; color: #9C6149; margin-top: 10rpx; line-height: 1.5; }

.form-card { margin-bottom: 10rpx; }
.form-card.is-busy { opacity: 0.68; }

.form-label { font-size: 27rpx; font-weight: 700; color: #433832; margin-bottom: 18rpx; }
.form-link { font-size: 23rpx; color: #FF7A59; }
.mt { margin-top: 28rpx; }

.chip-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.chip-row.wrap { flex-wrap: wrap; }

.baby-single { font-size: 26rpx; color: #6E615A; }
.baby-link { color: #FF7A59; margin-left: 16rpx; font-size: 23rpx; }

/* 过敏食材只读区 */
.allergy-head { display: flex; align-items: center; justify-content: space-between; }
.allergy-head .form-label { margin-bottom: 0; }
.allergy-row { margin-top: 18rpx; }
.allergy-chip {
  font-size: 23rpx;
  color: #E0526E;
  background: #FFE9ED;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin: 0 14rpx 12rpx 0;
}
.allergy-empty { font-size: 23rpx; color: #B0A49B; margin-top: 16rpx; }
.allergy-note { font-size: 21rpx; color: #A9A099; line-height: 1.6; margin: 8rpx 0 22rpx; }

/* 年龄边界提示（<6 个月 / 满 3 岁） */
.age-notice {
  background: #FFF3DC;
  color: #A9761A;
  font-size: 22rpx;
  line-height: 1.6;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

/* 本次生成条件回显 */
.cond-box { background: #FFF8F3; border-radius: 18rpx; padding: 20rpx 22rpx; margin: 0 0 24rpx; }
.cond-title { font-size: 22rpx; color: #8A7C74; font-weight: 600; margin-bottom: 16rpx; }
.cond-row { display: flex; align-items: flex-start; margin-bottom: 10rpx; }
.cond-row:last-child { margin-bottom: 0; }
.cond-key { width: 130rpx; flex: 0 0 130rpx; font-size: 22rpx; color: #A9A099; }
.cond-val { flex: 1; min-width: 0; font-size: 23rpx; color: #433832; line-height: 1.6; }
.cond-chips { display: flex; flex-wrap: wrap; }
.cond-chip {
  font-size: 21rpx; color: #E0526E; background: #FFE9ED;
  border-radius: 999rpx; padding: 4rpx 14rpx; margin: 0 10rpx 6rpx 0;
}
.cond-none { font-size: 22rpx; color: #B0A49B; }

.gen-btn { margin-top: 8rpx; }
.btn-busy { opacity: 0.7; }
.engine-tip { font-size: 21rpx; color: #B0A49B; text-align: center; margin-top: 18rpx; line-height: 1.5; }

/* ---------- 生成中 loading ---------- */
.loading-card { padding: 40rpx 32rpx 34rpx; }
.spinner-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.spinner-ring {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border: 8rpx solid #FFE7D6;
  border-top-color: #FF7A59;
  border-radius: 50%;
  animation: bf-spin 0.9s linear infinite;
}
.spinner-emoji { font-size: 54rpx; }
@keyframes bf-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.loading-title { font-size: 28rpx; font-weight: 700; color: #433832; text-align: center; }
.loading-cond { font-size: 22rpx; color: #A9A099; text-align: center; margin-top: 12rpx; line-height: 1.6; }
.loading-track { height: 8rpx; background: #F6EDE8; border-radius: 999rpx; overflow: hidden; margin: 28rpx 0 14rpx; }
.loading-progress {
  width: 40%; height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #FFB59A, #FF7A59);
  animation: bf-slide 1.6s ease-in-out infinite;
}
@keyframes bf-slide { from { transform: translateX(-100%); } to { transform: translateX(320%); } }
.loading-wait { font-size: 21rpx; color: #B0A49B; text-align: center; }

.skeleton { margin-top: 34rpx; }
.sk-line {
  height: 22rpx;
  border-radius: 8rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(90deg, #F6F1EE 25%, #FFEDE6 50%, #F6F1EE 75%);
  background-size: 200% 100%;
  animation: bf-shimmer 1.4s linear infinite;
}
.sk-line:last-child { margin-bottom: 0; }
.sk-title { height: 32rpx; width: 56%; }
.sk-mid { width: 84%; }
.sk-short { width: 62%; }
@keyframes bf-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

/* ---------- 结果卡片 ---------- */
.recipe-card { margin-bottom: 24rpx; }
.recipe-top { display: flex; align-items: center; }

.recipe-emoji {
  width: 108rpx;
  height: 108rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FFE7D6, #FFC4A8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 22rpx;
}

.recipe-title { font-size: 34rpx; font-weight: 700; }
.recipe-sub { font-size: 23rpx; color: #A0978F; margin-top: 10rpx; line-height: 1.5; }
.recipe-tags { margin: 22rpx 0 8rpx; }

.source-line { display: flex; align-items: center; flex-wrap: wrap; margin-top: 20rpx; }
.source-tag {
  font-size: 21rpx;
  color: #8A7C74;
  background: #F4F0ED;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin-right: 14rpx;
}
.source-tag.source-ai { color: #FF7A59; background: #FFEDE6; }
.source-note { font-size: 20rpx; color: #B0A49B; flex: 1; min-width: 0; }

.result-cond { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.result-cond-item {
  font-size: 21rpx; color: #7C706A; background: #FAF6F3;
  border-radius: 8rpx; padding: 8rpx 14rpx; margin: 0 12rpx 10rpx 0;
}

.recipe-meta {
  display: flex;
  background: #FAF6F3;
  border-radius: 18rpx;
  padding: 20rpx 10rpx;
  margin: 18rpx 0 10rpx;
}

.meta-cell { flex: 1; text-align: center; font-size: 21rpx; color: #7C706A; }
.meta-icon { margin-right: 6rpx; }

.sub-title { font-size: 28rpx; font-weight: 700; margin: 34rpx 0 18rpx; }

.ing-line {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #6E615A;
  padding: 12rpx 0;
  border-bottom: 2rpx dashed #F3ECE7;
}

.dot { color: #FF7A59; margin-right: 14rpx; font-weight: 700; }
.amount { color: #FF7A59; font-weight: 600; }

.step { display: flex; margin-bottom: 26rpx; }

.step-no {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  border-radius: 50%;
  background: #FFEDE6;
  color: #FF7A59;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.step-body { flex: 1; padding-top: 4rpx; }
.step-title { font-size: 26rpx; font-weight: 700; color: #433832; margin-bottom: 8rpx; }
.step-desc { font-size: 24rpx; color: #82766F; line-height: 1.7; }

.tip-line { font-size: 23rpx; color: #82766F; line-height: 1.7; margin-bottom: 8rpx; }

.nutrition {
  margin-top: 20rpx;
  background: #E6F7F0;
  color: #3CA884;
  font-size: 23rpx;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

/* 手动保存区 */
.save-area { margin-top: 30rpx; padding-top: 26rpx; border-top: 2rpx dashed #F3ECE7; }
.unsaved-tip {
  font-size: 22rpx; color: #C98A3C; background: #FFF6E8;
  border-radius: 14rpx; padding: 16rpx 18rpx; margin-bottom: 20rpx; line-height: 1.6;
}
.saved-tip {
  font-size: 22rpx; color: #3CA884; background: #E6F7F0;
  border-radius: 14rpx; padding: 16rpx 18rpx; margin-bottom: 20rpx; line-height: 1.6;
}
.save-btn { width: 100%; }
.save-btn.save-done { background: #E6F7F0; color: #3CA884; }

.recipe-actions { display: flex; margin-top: 20rpx; }
.act-btn { flex: 1; }
.act-btn:first-child { margin-right: 20rpx; }
