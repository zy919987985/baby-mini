<view class="page-wrap">

  <view class="msg-head">
    <view class="flex1">
      <view class="msg-title">互动消息</view>
      <view class="msg-sub">{{unread > 0 ? '有 ' + unread + ' 条未读消息' : '全部消息都已读完啦'}}</view>
    </view>
    <view class="read-all" bindtap="onReadAll">全部已读</view>
  </view>

  <view class="segment">
    <view class="seg-item {{filter === '全部' ? 'seg-on' : ''}}" data-f="全部" bindtap="onFilter">全部</view>
    <view class="seg-item {{filter === '未读' ? 'seg-on' : ''}}" data-f="未读" bindtap="onFilter">未读</view>
    <view class="seg-item {{filter === '点赞' ? 'seg-on' : ''}}" data-f="点赞" bindtap="onFilter">点赞</view>
    <view class="seg-item {{filter === '评论' ? 'seg-on' : ''}}" data-f="评论" bindtap="onFilter">评论</view>
  </view>

  <view class="card msg-card">
    <view wx:for="{{messages}}" wx:key="id" class="msg-row" data-id="{{item.id}}" data-post="{{item.postId}}" bindtap="onOpen">
      <view class="msg-avatar" style="background:{{item.bgColor}}">{{item.avatar}}</view>
      <view class="flex1">
        <view class="row-between">
          <view class="msg-row-title">{{item.title}}</view>
          <view wx:if="{{!item.read}}" class="unread-dot"></view>
        </view>
        <view class="msg-desc">{{item.desc}}</view>
        <view class="msg-time">{{item.timeText}}</view>
      </view>
      <text wx:if="{{item.postId}}" class="msg-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{messages.length === 0}}" class="empty">
    <text class="empty-emoji">🔔</text>
    <view class="empty-text">暂时没有{{filter === '全部' ? '' : filter}}消息，去首页逛逛吧</view>
  </view>

  <view class="msg-foot">💡 点赞、评论、收藏、发布帖子后，互动记录都会出现在这里</view>

  <view wx:if="{{__locked}}" class="lock-mask">
    <view class="lock-card">
      <view class="lock-emoji">🔒</view>
      <view class="lock-title">登录后查看</view>
      <view class="lock-sub">互动消息为个人隐私，请先登录后查看</view>
      <view class="btn-primary lock-btn" bindtap="onRequireLogin">立即登录</view>
    </view>
  </view>

  <auth-modal />
</view>
